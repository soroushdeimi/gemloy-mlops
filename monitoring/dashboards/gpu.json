{
  "title": "Gemloy gpu",
  "uid": "gemloy-gpu",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "gemloy"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "GPU temperature (C)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_TEMP or nvidia_smi_temperature_gpu",
          "legendFormat": "{{instance}} {{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Framebuffer used (MiB)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED or nvidia_smi_memory_used_bytes / 1048576",
          "legendFormat": "{{instance}} {{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "GPU utilization (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL or nvidia_smi_utilization_gpu_ratio * 100",
          "legendFormat": "{{instance}} {{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "XID error code",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_XID_ERRORS",
          "legendFormat": "{{instance}} {{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "description": "DCGM only. nvidia-smi does not expose XID events, so this panel stays empty on WSL2."
    }
  ]
}
